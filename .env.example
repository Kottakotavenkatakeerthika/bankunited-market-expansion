# Copy this file to .env (which is never committed) and fill in your own keys.
FRED_API_KEY=
BEA_API_KEY=
BLS_API_KEY=
# FDIC Summary of Deposits (src/ingest_fdic.py). Free key: https://api.data.gov/signup/
FDIC_API_KEY=
# Optional: raises Census API limits
CENSUS_API_KEY=
# SEC EDGAR requires a User-Agent with your name and email
HTTP_USER_AGENT="Your Name your.email@charlotte.edu"
# Optional: keep raw downloads on the pod's shared Drive instead of this computer.
# Point it at the folder Google Drive for desktop syncs. Use forward slashes:
# a backslash before "r" or "n" inside quotes turns into a control character.
# RAW_DATA_DIR="G:/My Drive/BankUnited Pod Data/raw"
RAW_DATA_DIR=
