# Copy this file to .env (which is never committed) and fill in your own values.
# The README's Setup section says which ones a rebuild needs and where to sign up.

# Needed to rebuild the tables from the sources. Three separate sign-ups, each free.
# FDIC BankFind, for Summary of Deposits and Call Reports: https://api.data.gov/signup/
FDIC_API_KEY=
# FRED: sign in to a FRED account, then request a key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# BEA: https://apps.bea.gov/API/signup/
BEA_API_KEY=
# Your name and email, sent as the User-Agent with every download
HTTP_USER_AGENT="Your Name your.email@charlotte.edu"

# Not read by any source today (the BLS and Census data come as public files). Leave empty.
BLS_API_KEY=
CENSUS_API_KEY=

# Leave empty unless you refresh a source for the pod: raw files then go to data/raw/ in your clone.
# Data engineers who own a source point this at the pod's shared Drive folder, synced by
# Google Drive for desktop. Use forward slashes: a backslash before "r" or "n" inside quotes
# turns into a control character.
# RAW_DATA_DIR="G:/My Drive/BankUnited Pod Data/raw data"
RAW_DATA_DIR=
